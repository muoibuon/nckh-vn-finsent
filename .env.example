# Copy file này thành `.env` và điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit `.env` lên Git.

# ==== HuggingFace (để download Qwen, Llama, ...) ====
HF_TOKEN=hf_your_token_here

# ==== Claude API (điểm neo commercial, ~200 tin) ====
ANTHROPIC_API_KEY=sk-ant-...

# ==== OpenAI (điểm neo commercial, ~200 tin) ====
OPENAI_API_KEY=sk-...

# ==== Đường dẫn ====
DATA_DIR=./data
CACHE_DIR=./.cache
RESULTS_DIR=./results

# ==== Seed ====
SEED=42

# ==== GPU config ====
CUDA_VISIBLE_DEVICES=0
